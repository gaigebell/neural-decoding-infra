# ───────────────────── Required ─────────────────────
# Get from https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# ───────────────────── Optional ─────────────────────
# Weights & Biases project name (defaults to "neural-decoding-infra")
WANDB_PROJECT=neural-decoding-infra

# W&B entity (team name; leave blank for personal account)
WANDB_ENTITY=

# Set to "online" (default), "offline", or "disabled"
WANDB_MODE=online

# ───────────────────── Cluster ─────────────────────
# Master node for multi-node training (use the launcher script; this is a fallback)
MASTER_ADDR=cn3
MASTER_PORT=29500

# Default working nodes (space-separated)
RECON_NODES=cn3 gn14 gn15 gn16

# ───────────────────── Reproducibility ─────────────────────
# Hash seed for Python's built-in hash randomization
PYTHONHASHSEED=0

# CUDA / cuBLAS determinism (slower but reproducible)
CUBLAS_WORKSPACE_CONFIG=:4096:8

# ───────────────────── Logging ─────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
RECON_LOG_LEVEL=INFO

# ───────────────────── Notes ─────────────────────
# - Copy this file to `.env` and fill in real values
# - `.env` is in .gitignore — never commit secrets
# - To load: `export $(grep -v '^#' .env | xargs)` or use python-dotenv