# EditorConfig is awesome: https://EditorConfig.org
# Top-level config; per-language overrides below.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
trim_trailing_whitespace = false  # Markdown needs trailing spaces for line breaks

[*.{yaml,yml,toml}]
indent_size = 2

[*.{json}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab

[*.{cfg,ini}]
indent_size = 4